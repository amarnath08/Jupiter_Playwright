{
  "name": "jupiter-toys-playwright",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E test suite for Jupiter Toys",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:tc1": "playwright test tests/tc1-contact-validation.spec.ts",
    "test:tc2": "playwright test tests/tc2-successful-submission.spec.ts",
    "test:tc3": "playwright test tests/tc3-cart.spec.ts",
    "test:tc1:headed": "playwright test tests/tc1-contact-validation.spec.ts --headed",
    "test:tc2:headed": "playwright test tests/tc2-successful-submission.spec.ts --headed",
    "test:tc3:headed": "playwright test tests/tc3-cart.spec.ts --headed",
    "test:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@faker-js/faker": "8.4.1",
    "@playwright/test": "1.44.0",
    "@types/node": "20.11.30",
    "typescript": "5.4.5"
  }
}